MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=rekvisit_register
PORT=3000
# Valgfrit: absolut sti til en privat mappe til rekvisitbilleder.
# Uden denne variabel bruges ~/.rekvisit-register/images.
# PROP_IMAGE_DIR=/absolute/path/to/rekvisit-images
AUTH_TOKEN_SECRET=
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Rekvisit Register <no-reply@example.dk>
INITIAL_ASSOCIATION_NAME=Din teaterforening
INITIAL_ADMIN_FIRST_NAME=Fornavn
INITIAL_ADMIN_LAST_NAME=Efternavn
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.dk
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-passphrase